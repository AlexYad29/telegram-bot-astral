# ============================================================
# Telegram bot
# ============================================================
BOT_TOKEN=123456:your_telegram_bot_token_here
BOT_USERNAME=astro_oracle_bot

# Telegram channel for auto-posting.
# Either @channel_username or numeric id like -1001234567890.
CHANNEL_ID=@your_channel

# Comma-separated list of Telegram user IDs with admin rights.
ADMIN_IDS=11111111,22222222

# ============================================================
# OpenAI
# ============================================================
OPENAI_API_KEY=sk-...your_openai_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.9
OPENAI_MAX_TOKENS=600

# ============================================================
# PostgreSQL
# ============================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=astrobot
POSTGRES_USER=astrobot
POSTGRES_PASSWORD=astrobot

# ============================================================
# Redis (FSM storage, throttling, caches)
# ============================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ============================================================
# Application
# ============================================================
ENV=production
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow

# Anti-spam / rate limiting
RATE_LIMIT_MESSAGES_PER_MINUTE=20
THROTTLE_DEFAULT_RATE=0.5
